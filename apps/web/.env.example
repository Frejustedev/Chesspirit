# --- Application web (copier en .env.local) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (valeurs locales par défaut : pile locale ou `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret serveur : ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Paiement : fake (défaut en développement) | fedapay | kkiapay
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_SECRET=
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# Notifications : fournisseurs factices sans clé
RESEND_API_KEY=
EMAIL_FROM="Chesspirit <no-reply@chesspirit.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Service échecs (Python)
CHESS_ENGINE_URL=http://localhost:8000
CHESS_ENGINE_KEY=

# Connexion Google (activer aussi le fournisseur dans Supabase)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Statistiques et erreurs (désactivés sans valeur)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
