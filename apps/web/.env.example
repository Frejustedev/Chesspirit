# --- Application web (copier en .env.local) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (valeurs locales par défaut : pile locale ou `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret serveur : ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Paiement : fake (défaut en développement) | fedapay | kkiapay
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_SECRET=
# Le paiement simulé est refusé en production, sauf ALLOW_FAKE_PAYMENTS=true (préproduction uniquement)
ALLOW_FAKE_PAYMENTS=false
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# Notifications : fournisseurs factices sans clé
RESEND_API_KEY=
EMAIL_FROM="Chesspirit <no-reply@chesspirit.com>"
# SMS (Twilio) ; les codes de connexion SMS sont envoyés par Supabase (fournisseur SMS à configurer côté Supabase)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Langue des modèles WhatsApp approuvés
WHATSAPP_TEMPLATE_LANG=fr
# Assistant WhatsApp (webhook) : jeton de vérification choisi librement et secret de l'application Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Service échecs (Python)
CHESS_ENGINE_URL=http://localhost:8000
CHESS_ENGINE_KEY=

# Connexion Google : vide = le bouton suit le fournisseur activé dans Supabase ; « false » le masque.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# Statistiques et erreurs (désactivés sans valeur)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=
# Sentry : prévu mais non branché dans le code (voir PROGRESS.md, « À reprendre »)
# SENTRY_DSN=

# Lichess : liaison des comptes (OAuth PKCE, aucun secret) ; jeton du compte Chesspirit pour créer des tournois (facultatif)
LICHESS_CLIENT_ID=chesspirit.com
LICHESS_API_TOKEN=
# true uniquement en local : liaison et import simulés
LICHESS_FAKE=false

# Lecture des feuilles de notation : « fake » (lecture simulée) tant qu'aucun service n'est branché
OCR_PROVIDER=fake

# Tâches planifiées : jeton exigé par /api/cron/* (Vercel Cron l'envoie automatiquement)
CRON_SECRET=

# Liste FIDE (par défaut : fichier officiel mensuel)
FIDE_LIST_URL=

# Bandeau « démonstration » (mettre false en production une fois les données fictives retirées)
NEXT_PUBLIC_DEMO_BANNER=true

# --- Utilisées seulement par scripts/setup-production.sh (fichier .env.production, jamais versionné) ---
# Référence du projet Supabase (Settings → General), pour appliquer les migrations
SUPABASE_PROJECT_REF=
# Super-administrateur à créer au premier lancement
ADMIN_EMAIL=
ADMIN_PHONE=
