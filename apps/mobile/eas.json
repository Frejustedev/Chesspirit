{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SITE_URL": "http://localhost:3000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_SITE_URL": "https://chesspirit.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_SITE_URL": "https://chesspirit.com" }
    }
  },
  "submit": {
    "production": {}
  }
}
